# ============================================
# Audit DAO (CeatDAO) 环境变量配置模板
# ============================================
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# --- 当前活跃网络 (31337=本地，11155111=Sepolia) ---
CHAIN_ID=31337

# --- 管理员私钥（用于链上交易签名）---
# 本地 Hardhat 默认私钥（用于测试，请勿用于生产）
ADMIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ============================================
# 本地 Hardhat 网络配置 (chainId=31337)
# ============================================
RPC_URL=http://127.0.0.1:8545

# 本地合约地址（运行 local_deploy.js 后自动生成）
LOCAL_AUDIT_DAO_ADDRESS=
LOCAL_CEAT_TOKEN_ADDRESS=
LOCAL_TEAM_MANAGER_ADDRESS=

# ============================================
# Sepolia 测试网配置 (chainId=11155111)
# ============================================
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Sepolia 合约地址（部署后填写）
SEPOLIA_AUDIT_DAO_ADDRESS=
SEPOLIA_CEAT_TOKEN_ADDRESS=
SEPOLIA_TEAM_MANAGER_ADDRESS=

# ============================================
# 兼容旧版单地址配置（如果未设 LOCAL_* 和 SEPOLIA_*，则使用这些作为回退）
# ============================================
# AUDIT_DAO_ADDRESS=
# CEAT_TOKEN_ADDRESS=

# --- AI 审计引擎 (DeepSeek API) ---
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# --- 数据库 ---
# 默认使用项目根目录的 SQLite (audit_dao.db)
# 生产环境可改为 PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/audit_dao
DATABASE_URL=sqlite:///audit_dao.db

# --- 服务配置 ---
# 后端服务端口 (默认 8000)
PORT=8000
