# ============================================
# Audit DAO (CreatDAO) 环境变量配置模板
# ============================================
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# --- 管理员私钥（用于链上交易签名）---
ADMIN_PRIVATE_KEY=your_private_key_here_without_0x_prefix

# --- Sepolia 测试网 ---
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# --- 合约地址 (Sepolia) ---
AUDIT_DAO_ADDRESS=0x0A531f1085458f5d7b04bbD16120c37E9b1784CE
CEAT_TOKEN_ADDRESS=0x1C8aE2804ac7083a7abC340185cFA630BB587AE9

# --- AI 审计引擎 (DeepSeek API) ---
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# --- 数据库 ---
# 默认使用项目根目录的 SQLite (audit_dao.db)
# 生产环境可改为 PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/audit_dao
DATABASE_URL=sqlite:///audit_dao.db

# --- 服务配置 ---
# 后端服务端口 (默认 8000)
PORT=8000
